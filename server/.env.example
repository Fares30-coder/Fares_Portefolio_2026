PORT=3001
# Adresses du front autorisées à appeler l'API, séparées par des virgules
# (en production : https://ton-domaine.fr,https://www.ton-domaine.fr)
CLIENT_ORIGIN=http://localhost:5173

# Adresse qui reçoit les messages du formulaire de contact
CONTACT_TO=fares.haouari@epitech.eu

# Option 1 (production / Render) : Resend, via HTTPS — prioritaire si renseigné
RESEND_API_KEY=
# RESEND_FROM=Portfolio <onboarding@resend.dev>

# Option 2 (local) : SMTP, par ex. Gmail avec un mot de passe d'application
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
